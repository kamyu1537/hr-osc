{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:path:allow-resolve-directory",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-rename",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPCONFIG/data" }, { "path": "$APPCONFIG/data/*" }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://api.stromno.com/*" }]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/*" },
        { "url": "https://twitter.com/*" },
        { "url": "https://pulsoid.net/*" },
        { "url": "https://app.stromno.com/*" }
      ]
    }
  ]
}
