{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "windows": ["main"],
  "permissions": [
    "core:app:allow-version",
    "core:path:allow-resolve-directory",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-file",
    "fs:allow-rename",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPCONFIG/data" }, { "path": "$APPCONFIG/data/*" }]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.stromno.com/v1/api/public/rpc" },
        { "url": "https://dev.pulsoid.net/api/v1/token/validate" },
        { "url": "https://pulsoid.net/oauth2/device_authorization" },
        { "url": "https://pulsoid.net/oauth2/token" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/kamyu1537/hr-osc.git" },
        { "url": "https://github.com/kamyu1537/hr-osc/releases/latest" },
        { "url": "https://github.com/sponsors/kamyu1537" },
        { "url": "https://twitter.com/kamyu1537" },
        { "url": "https://twitter.com/selees824" },
        { "url": "https://pulsoid.net/ui/configuration" },
        { "url": "https://pulsoid.net/ui/keys" },
        { "url": "https://pulsoid.net/oauth2/device_authorization_consent[?]user_code=*" },
        { "url": "https://app.stromno.com/dashboard" }
      ]
    }
  ]
}
